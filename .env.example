# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of the app (used for absolute links in emails / OG images)
NEXT_PUBLIC_APP_URL=

# Email (Resend) — optional. If RESEND_API_KEY is unset, emails are skipped
# (logged) so the app still works in development.
RESEND_API_KEY=
# Optional custom sender; defaults to Resend's shared onboarding domain.
EMAIL_FROM="NakedTruth <onboarding@resend.dev>"

# Cron — secures /api/cron/reminders. When set, Vercel Cron automatically sends
# it as "Authorization: Bearer <CRON_SECRET>" and the endpoint rejects anything else.
CRON_SECRET=
