# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of the deployed app (used for invite/checkout links)
NEXT_PUBLIC_APP_URL=

# ── Email (Resend) ────────────────────────────────────────
RESEND_API_KEY=
# Optional verified sender, e.g. "NakedTruth <ahoj@nakedtruth.cz>"
RESEND_FROM=

# ── Stripe (tier_2 unlock) ────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price ID for the one-time tier_2 unlock (CZK)
STRIPE_PRICE_TIER2=

# ── Analytics (PostHog) ───────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
