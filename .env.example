# Neon Postgres (server-side only). Use the pooled connection string from the
# Neon console. Set up the schema with: npm run db:setup
DATABASE_URL=

# Public base URL of the app (used for absolute links in emails / OG images)
NEXT_PUBLIC_APP_URL=

# Email (Resend). Sends purchase confirmations, links to results, quiz invites
# and reminders. If RESEND_API_KEY is unset, emails are skipped (logged) and
# the "e-mail me my link" forms say sending is unavailable.
RESEND_API_KEY=
# Sender. Resend's shared onboarding domain only delivers to the account
# owner's own address — verify a domain in Resend and set this for real use.
EMAIL_FROM="NakedTruth <onboarding@resend.dev>"

# Cron — secures /api/cron/reminders. When set, Vercel Cron automatically sends
# it as "Authorization: Bearer <CRON_SECRET>" and the endpoint rejects anything else.
CRON_SECRET=

# Stripe (premium unlock). Without these, checkout/webhook return 503 and the
# rest of the app still works.
STRIPE_SECRET_KEY=
# From the Stripe webhook endpoint config; used to verify /api/webhooks/stripe.
STRIPE_WEBHOOK_SECRET=

# Opens the usage overview at /stats?key=<STATS_KEY>. Unset = the page does not exist.
STATS_KEY=
